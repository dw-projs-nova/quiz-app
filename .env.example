# Generate a random value for production, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-local-development-secret

# This account receives administrator access when it first signs in.
ADMIN_EMAIL=

# This account receives instructor access when it first signs in.
INSTRUCTOR_EMAIL=

# SMTP settings
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=false
SMTP_FROM=Quiz App <noreply@localhost>
